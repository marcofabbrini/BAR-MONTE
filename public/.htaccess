# App GESDI: la pagina principale non va tenuta in cache, così gli aggiornamenti arrivano subito.
# (I file in /assets hanno un nome con impronta digitale e possono restare in cache.)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "same-origin"
</IfModule>
AddDefaultCharset UTF-8

# File di stato del deploy automatico: non deve essere leggibile dal web.
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# App installabile (PWA): tipo corretto per il manifest e service worker sempre aggiornato.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
